# Names and safe local defaults only. Real values live outside the repo.
DATABASE_URL=postgres://crew:crew@127.0.0.1:55432/crew
# At least 32 random characters; signs CSRF tokens.
SESSION_SECRET=
PUBLIC_ORIGIN=https://crew.2p-solutions.com
# Extra allowed origins, comma-separated (e.g. http://localhost:5173 for Vite).
ALLOWED_ORIGINS=
HOST=0.0.0.0
PORT=8787
# Caddy network CIDRs trusted for X-Forwarded-For, comma-separated. Empty trusts no proxy.
TRUST_PROXY=
COOKIE_SECURE=true
LOGIN_RATE_LIMIT_PER_MINUTE=5
BUDGET_TIMEZONE=Asia/Ho_Chi_Minh
LOG_LEVEL=info
# GitHub repo whose runtime-v* releases (signed desktop runtime bundles) are imported hourly; empty turns it off.
RUNTIME_RELEASES_REPO=nquangphan/my-crew
# Extra trusted runtime signing keys (raw Ed25519, base64, comma-separated), e.g. a staging key. Usually empty.
RUNTIME_EXTRA_PUBLIC_KEYS=
# Tests only; the database name must end with _test.
TEST_DATABASE_URL=postgres://crew:crew@127.0.0.1:55432/crew_test
