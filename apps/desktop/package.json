{
  "name": "@crew/desktop",
  "productName": "2P Crew",
  "version": "0.3.0",
  "private": true,
  "description": "2P Crew: ứng dụng máy local chạy daemon, trình cài đặt và bảng sức khỏe",
  "author": "2P Solutions",
  "type": "module",
  "main": "./out/main/index.js",
  "crewRuntime": {
    "version": "0.3.0",
    "shell": ">=0.3.0 <0.4.0"
  },
  "scripts": {
    "dev": "pnpm build:app && electron-vite dev",
    "build": "tsc -p tsconfig.json && pnpm build:app",
    "build:app": "electron-vite build && electron-vite build -c electron.vite.host.config.ts && node scripts/runtime-bundle.mjs builtin",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "stage": "pnpm build:app && node scripts/stage-app.mjs",
    "test:e2e": "node scripts/stage-app.mjs --if-missing && playwright test",
    "package:mac": "pnpm build:app && node scripts/package-mac.mjs",
    "runtime:release": "pnpm build:app && node scripts/runtime-bundle.mjs release",
    "smoke:mac": "node scripts/smoke-packaged.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.283",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@crew/api": "workspace:*",
    "@crew/daemon": "workspace:*",
    "@crew/shared": "workspace:*",
    "@electron/rebuild": "4.2.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "jsdom": "^30.1.1",
    "lucide-react": "^1.48.0",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "vite": "^7.3.6",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
