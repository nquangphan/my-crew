{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "declaration": false,
    "types": ["node", "vite/client"],
    "paths": {
      "@crew/shared": ["../../packages/shared/src/index.ts"],
      "@crew/daemon": ["../daemon/src/library.ts"]
    }
  },
  "include": [
    "src",
    "test",
    "electron.vite.config.ts",
    "electron.vite.host.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
