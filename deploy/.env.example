# /opt/crew/.env of the VPS stack (deploy/compose.yml). Copy, fill in, then: chmod 600 /opt/crew/.env
# Never commit the real file. Secrets are empty here on purpose; generate them on the VPS.

# Public host name; the shared nginx serves it and certbot issues its certificate.
CREW_DOMAIN=crew.2p-solutions.com
# Must be https://$CREW_DOMAIN (the API's Origin allow-list and the cookie scope).
PUBLIC_ORIGIN=https://crew.2p-solutions.com

# Letters and digits only, 24+ characters (it is part of DATABASE_URL): openssl rand -hex 24
POSTGRES_PASSWORD=
# 32+ characters; signs CSRF tokens tied to the session: openssl rand -hex 32
SESSION_SECRET=

# Optional (defaults shown in deploy/compose.yml):
# COOKIE_SECURE=true
# TRUST_PROXY=uniquelocal
# LOGIN_RATE_LIMIT_PER_MINUTE=5
# LOG_LEVEL=info
# BACKUP_HOUR=2
# BACKUP_KEEP_DAYS=14
