sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"},{"path":"tests/writing-skills/test-render-graphs.sh","type":"file","mode":493,"bytes":2512,"sha256":"c977fb34ec6614400673cc3d73e9979eb5428d35e1413c50ab4b1cef47eb7b3b"}],"exclusions":[{"bytes":96,"classification":"discovery","mode":493,"path":".agents","reason":"runtime-discovery-directory","sha256":null,"type":"directory"},{"bytes":96,"classification":"discovery","mode":493,"path":".agents/skills","reason":"runtime-discovery-directory","sha256":null,"type":"directory"},{"bytes":96,"classification":"discovery","mode":493,"path":".agents/skills/foreign","reason":"runtime-discovery-directory","sha256":null,"type":"directory"},{"bytes":13,"classification":"discovery","mode":420,"path":".agents/skills/foreign/SKILL.md","reason":"runtime-discovery-directory","sha256":"1969bec2eead3f13b329cfc738efa5149f46630d0a462e4a33c0ebebd5c98f6f","type":"file"},{"bytes":20,"classification":"discovery","mode":420,"path":"AGENTS.md","reason":"runtime-instruction-or-configuration","sha256":"3bba87bf04c9b0eb6a5028b000e89207677c6c86aa5a4569b559480d5b9e40eb","type":"file"}],"surfaces":[{"surface":"pins-and-workspace","status":"PASS","measured":true,"reason":"registry bytes, owned identity and frozen workspace/Git inventory reverified"},{"surface":"shell-selected-projection-read","status":"PASS","measured":true,"reason":"selected audited bytes compared with registry manifest; not Skill invocation"},{"surface":"shell-selected-owned-read","status":"PASS","measured":true,"reason":"owned canary read with nofork receipt"},{"surface":"shell-absolute-other-source-denial","status":"PASS","measured":true,"reason":"kernel data read denied"},{"surface":"shell-symlink-other-source-denial","status":"PASS","measured":true,"reason":"kernel data read denied"},{"surface":"shell-dotdot-other-source-denial","status":"PASS","measured":true,"reason":"kernel data read denied"},{"surface":"shell-common-dir-denial","status":"PASS","measured":true,"reason":"kernel data read denied"},{"surface":"shell-git-objectdb-denial","status":"PASS","measured":true,"reason":"kernel data read denied"},{"surface":"runtime-version","status":"PASS","measured":true,"reason":"codex-cli 0.159.3"},{"surface":"runtime-discovery","status":"UNVERIFIED","measured":true,"reason":"bounded stdin discovery; incomplete responses or unmeasured invocation cannot certify runtime"},{"surface":"native-Read","status":"UNVERIFIED","measured":false,"reason":"NATIVE_READ_UNVERIFIED"},{"surface":"native-Skill","status":"UNVERIFIED","measured":false,"reason":"NATIVE_SKILL_UNVERIFIED"},{"surface":"MCP-load-and-invoke","status":"UNVERIFIED","measured":false,"reason":"MCP_INVOKE_UNVERIFIED"},{"surface":"child-inheritance","status":"UNVERIFIED","measured":false,"reason":"CHILD_POLICY_UNVERIFIED"},{"surface":"whole-process-tree","status":"UNVERIFIED","measured":false,"reason":"FULL_TREE_PROOF_UNVERIFIED"},{"surface":"official-renderer-invoke","status":"UNVERIFIED","measured":false,"reason":"RENDERER_INVOKE_UNVERIFIED"}],"discovery":[{"id":1,"result":{"userAgent":"crew_isolation_probe/0.159.3 (Mac OS 26.5.2; arm64) unknown (crew_isolation_probe; 1)","codexHome":"/private/tmp/crew6-w-pJZKVi/isolation/operations/stages/f623a041-a10e-4c8d-86e6-fa4c1203f518/home/codex","platformFamily":"unix","platformOs":"macos"}},{"method":"remoteControl/status/changed","params":{"status":"disabled","serverName":"Phans-MacBook-Pro.local","installationId":"9c4cf4b4-18cd-4e5c-9f8d-b5ef36f89f87","environmentId":null},"emittedAtMs":1790939279460}],"origins":[],"blockers":["bounded stdin discovery; incomplete responses or unmeasured invocation cannot certify runtime","NATIVE_READ_UNVERIFIED","NATIVE_SKILL_UNVERIFIED","MCP_INVOKE_UNVERIFIED","CHILD_POLICY_UNVERIFIED","FULL_TREE_PROOF_UNVERIFIED","RENDERER_INVOKE_UNVERIFIED"],"sha256":"701b26a1b9543442ab323b8b2e22e9fd8e68394c011a70e16c5f840346eddbb0"},"blockers":["bounded stdin discovery; incomplete responses or unmeasured i