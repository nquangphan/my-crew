Task6 claude no-model evidence {"status":"UNVERIFIED","evidence":{"formatVersion":1,"runtime":"claude","source":{"name":"superpowers","version":"6.4.2","sourceRevision":"8ca22dba9a94f28898bbce59f2537ff4d87c747d","sourceUrl":"https://codeload.github.com/obra/superpowers/tar.gz/8ca22dba9a94f28898bbce59f2537ff4d87c747d","payloadSha256":"29714b2c4c727ecc6600f9e5982a0dcbb829860ba79626f1941a0f233e85331a","packageIntegrity":null,"sourceManifestSha256":"e5cf239cc4fd5757338fb435de881d6246948cd1d902fa21b4498a63d5a10dc2","sourceTreeSha256":"76972851ae1f527b6e323866cf9562d6f07f0b44af656e7f453224699507ac46"},"projection":{"runtime":"claude","sourceTreeSha256":"76972851ae1f527b6e323866cf9562d6f07f0b44af656e7f453224699507ac46","manifestSha256":"b87eaf7d6404ed4fd92650e98d3f20a3060a18de6a3192781de4f1f2871b0347","derivation":{"tool":"crew-reviewed-official-layout-copy","version":"1","options":["claude-plugin-dir"],"layoutSchema":"superpowers-claude-plugin-v1","policySha256":"552a23187fa99ddefb9a4c82fccf2b653e5e9e8f13bfd0a9eecf6913cf8eb4aa"},"treeSha256":"2cc167b34d987b4c87b8b311434cad0131213d53dbdf5552f4c7d9e3de70d3f4"},"workspace":"/private/tmp/crew6-w-pJZKVi/isolation/operations/stages/6dfad140-b2ad-4a07-8c60-5464387b51de/workspace","attemptHome":"/private/tmp/crew6-w-pJZKVi/isolation/operations/stages/6dfad140-b2ad-4a07-8c60-5464387b51de/home","os":{"platform":"darwin","release":"25.5.0","arch":"arm64"},"productionEnabled":false,"policyVersion":"crew-source-preflight-v1","commands":[{"operationId":"ffd7e68c-ae81-42b8-a17d-b3adb63c7800","argv":["/usr/bin/env","HOME=/private/tmp/crew6-w-pJZKVi/isolation/operations/stages/6dfad140-b2ad-4a07-8c60-5464387b51de/home","CLAUDE_CONFIG_DIR=/private/tmp/crew6-w-pJZKVi/isolation/operations/stages/6dfad140-b2ad-4a07-8c60-5464387b51de/home/claude","CODEX_HOME=/private/tmp/crew6-w-pJZKVi/isolation/operations/stages/6dfad140-b2ad-4a07-8c60-5464387b51de/home/codex","TMPDIR=/private/tmp/crew6-w-pJZKVi/isolation/operations/stages/6dfad140-b2ad-4a07-