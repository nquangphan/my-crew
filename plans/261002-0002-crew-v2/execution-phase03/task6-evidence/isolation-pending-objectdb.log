Task6 api no-model evidence {"status":"UNVERIFIED","evidence":{"formatVersion":1,"runtime":"api","source":{"name":"superpowers","version":"6.4.2","sourceRevision":"8ca22dba9a94f28898bbce59f2537ff4d87c747d","sourceUrl":"https://codeload.github.com/obra/superpowers/tar.gz/8ca22dba9a94f28898bbce59f2537ff4d87c747d","payloadSha256":"29714b2c4c727ecc6600f9e5982a0dcbb829860ba79626f1941a0f233e85331a","packageIntegrity":null,"sourceManifestSha256":"e5cf239cc4fd5757338fb435de881d6246948cd1d902fa21b4498a63d5a10dc2","sourceTreeSha256":"76972851ae1f527b6e323866cf9562d6f07f0b44af656e7f453224699507ac46"},"projection":{"runtime":"api","sourceTreeSha256":"76972851ae1f527b6e323866cf9562d6f07f0b44af656e7f453224699507ac46","manifestSha256":"8c76b92343e5afb5f18a1ab8c267da2754b9c369d2a26634fecbe20da84f0c5b","derivation":{"tool":"crew-reviewed-official-api-transport","version":"1","options":["exact-official-skills-and-scripts"],"layoutSchema":"superpowers-api-v1","policySha256":"23e33930a7e86e9d317b6e59dd3976024a98e24aefc7baefcb2be8970ca693ca"},"treeSha256":"ec4631651e859dc1bf850d2980d0d8a3937d428b3d787e29ffdbe05b4a11720d"},"workspace":"/private/tmp/crew6-w-QxfxkC/isolation/operations/stages/16889d0a-1c43-4a35-8edf-930bf18fe546/workspace","attemptHome":"/private/tmp/crew6-w-QxfxkC/isolation/operations/stages/16889d0a-1c43-4a35-8edf-930bf18fe546/home","os":{"platform":"darwin","release":"25.5.0","arch":"arm64"},"productionEnabled":false,"policyVersion":"crew-source-preflight-v1","commands":[{"operationId":"7b5f3b8e-ae30-4bb2-a27b-f282005d12db","argv":["/usr/bin/env","HOME=/private/tmp/crew6-w-QxfxkC/isolation/operations/stages/16889d0a-1c43-4a35-8edf-930bf18fe546/home","CLAUDE_CONFIG_DIR=/private/tmp/crew6-w-QxfxkC/isolation/operations/stages/16889d0a-1c43-4a35-8edf-930bf18fe546/home/claude","CODEX_HOME=/private/tmp/crew6-w-QxfxkC/isolation/operations/stages/16889d0a-1c43-4a35-8edf-930bf18fe546/home/codex","TMPDIR=/private/tmp/crew6-w-QxfxkC/isolation/operations/stages/16889d0a-1c43-4a35-8