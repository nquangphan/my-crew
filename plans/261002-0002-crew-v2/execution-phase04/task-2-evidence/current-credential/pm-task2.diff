+          choices?: { message: { tool_calls?: { id: string }[] } }[];
+        };
+        const ids =
+          provider.protocol === 'responses'
+            ? wire.output?.filter((x) => x.call_id).map((x) => x.call_id)
+            : wire.choices?.[0]?.message.tool_calls?.map((x) => x.id);
+        if (
+          !tool ||
+          ids?.length !== 1 ||
+          ids[0] !== tool.callId ||
+          tool.callId !== tool.resultCallId ||
+          tool.value !== 'fixture'
