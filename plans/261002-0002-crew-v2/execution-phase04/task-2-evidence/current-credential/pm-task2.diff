+  assert.equal(results.filter((r) => r.status === 'rejected').length, 1);
+  const bad: SecurityBridge = {
+    read: async () => {
+      throw new Error('plaintext fixture secret');
+    },
+    put: async () => {},
+    remove: async () => {
+      throw new Error('plaintext fixture secret');
+    },
+  };
+  const denied = new CredentialBroker(randomUUID(), bad, []);
