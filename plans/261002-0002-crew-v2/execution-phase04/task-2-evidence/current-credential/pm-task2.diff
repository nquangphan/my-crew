+      } catch {
+        return result('unverified', [], 'LIVE_NOT_AUTHORIZED');
+      }
+    }
+    const call = mode === 'offline' ? this.ports.offline : this.ports.authorizedLive?.call;
+    if (!call || key.runtime !== 'api')
+      return result(
+        'unverified',
+        [],
+        key.runtime === 'api' ? 'OFFLINE_UNVERIFIED' : 'ISOLATED_AUTH_UNVERIFIED',
+      );
