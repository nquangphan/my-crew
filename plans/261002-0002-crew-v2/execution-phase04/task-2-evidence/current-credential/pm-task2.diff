+      const b = values.get(s + a);
+      return b ? Buffer.from(b) : null;
+    },
+    async remove(s: string, a: string) {
+      values.delete(s + a);
+    },
+  };
+  const requests: string[] = [];
+  let onRead: (path: string) => void = () => {};
+  const read = async (path: string) => {
+    requests.push(path);
