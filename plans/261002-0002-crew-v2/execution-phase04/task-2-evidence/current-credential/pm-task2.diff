+          'MODEL_MISMATCH',
+          'TOOL_PROTOCOL',
+          'PROTOCOL',
+          'STREAM_PROTOCOL',
+          'VISION_UNSUPPORTED',
+          'RESPONSE_TOO_LARGE',
+          'SSRF_DENIED',
+        ].includes(error.message)
+          ? error.message
