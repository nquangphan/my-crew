+        });
+      if (hostile === 'iterator')
+        Object.defineProperty(values, Symbol.iterator, {
+          value: function* () {
+            executions++;
+            yield 'safe';
+          },
+        });
+      if (hostile === 'prototype') Object.setPrototypeOf(values, Object.create(Array.prototype));
+      const before = await f.state();
