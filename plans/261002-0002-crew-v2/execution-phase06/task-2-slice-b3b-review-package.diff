+async function harness(options: { maxAttempts?: number } = {}) {
+  const root = await mkdtemp(join(await realpath(tmpdir()), 'crew-b3b-'));
+  const server = await fakeServer();
+  const clock = { now: 1_000_000 };
+  const sleeps: number[] = [];
+  const open = () =>
+    createToolClient({
+      root,
+      baseUrl: server.url,
+      bearer,
+      now: () => clock.now,
+      sleep: async (ms) => {
