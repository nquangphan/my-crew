+
+export type RenderLayerPath =
+  | '_bmad/config.toml'
+  | '_bmad/config.user.toml'
+  | '_bmad/custom/config.toml'
+  | '_bmad/custom/config.user.toml'
+  | '_bmad/custom/bmad-build.toml'
+  | '_bmad/custom/bmad-build.user.toml'
