     const stat = await file.stat();
     if (!stat.isFile() || stat.nlink !== 1 || hash(await file.readFile()) !== entry.sha256)
       throw new Error('WORKFLOW_SKILL_MISMATCH');
   } finally {
     await file.close();
   }
