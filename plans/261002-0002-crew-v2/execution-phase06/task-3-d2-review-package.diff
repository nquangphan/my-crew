+        ...baseline.render.layers,
+        '_bmad/custom/bmad-build.toml': hash(overrides),
+      });
+      assert.notEqual(withLayer.customizationSha256, baseline.customizationSha256);
+      assert.notEqual(withLayer.sha256, baseline.sha256);
+    },
+  );
+});
