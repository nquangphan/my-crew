+        return {
+          questionId: String(question.id),
+          revision: Number(question.revision),
+          answerId,
+          decisionId,
+          gateId: idOrNull(question.gate_id),
+          gateState:
+            resolved.verdict === 'approve' ? 'approved' : resolved.verdict === 'reject' ? 'rejected' : null,
+        };
+      });
+    },
+
+    answerGate,
+  });
+}
