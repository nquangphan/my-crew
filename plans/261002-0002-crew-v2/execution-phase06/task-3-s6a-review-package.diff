+/** Absolute, normalized, well-formed and printable: safe to quote in a sandbox profile and argv. */
+function lexicalPath(value: unknown): value is string {
+  if (
+    typeof value !== 'string' ||
+    value.length < 2 ||
+    value.length > 4096 ||
+    !value.isWellFormed() ||
+    !posix.isAbsolute(value) ||
+    posix.normalize(value) !== value ||
+    value.endsWith('/')
