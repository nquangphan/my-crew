+  const base = {
+    runtime: 'claude' as const,
+    sourceTreeSha256: source.pin.sourceTreeSha256,
+    manifestSha256: manifestHash(manifest(validateFiles(out))),
+    derivation,
+  };
+  const { projectionTreeHash } = await import('../src/workflows/pins.ts');
