+async function withDb<T>(
+  crew: FixtureHandle,
+  run: (db: ReturnType<typeof connectDb>) => Promise<T>,
+): Promise<T> {
+  const db = connectDb(`postgres://postgres@127.0.0.1:${crew.dbPort}/${crew.dbName}`);
+  try {
+    return await run(db);
+  } finally {
+    await db.end({ timeout: 2 });
+  }
