+test('unit: scratch REMOVE hết hạn rồi stat trả trễ phải giữ registry', async () => {
+  const scratchPath = await mkdtemp(join(tmpdir(), 'crew-v2-web-fix2-'));
+  const registryPath = join(scratchPath, 'registry.json');
+  await writeFile(registryPath, '{"phase":"unknown"}', { mode: 0o600 });
+  const original = await stat(scratchPath);
+  const identity = String(original.dev) + ':' + String(original.ino);
+  const resource: OwnedResource = {
+    kind: 'scratch',
+    id: scratchPath,
+    ownershipNonce: 'unit-scratch-timeout',
+    startIdentity: identity,
+  };
+  console.log(
+    'scratch-timeout-ready=' + JSON.stringify({ scratchPath, registryPath, startIdentity: identity }),
+  );
+  let releaseStat: () => void = () => undefined;
+  const delayed = new Promise<void>((resolve) => {
+    releaseStat = resolve;
+  });
+  let markStatStarted: () => void = () => undefined;
+  const statStarted = new Promise<void>((resolve) => {
+    markStatStarted = resolve;
+  });
+  let removeCalls = 0;
+  let lateRemove: Promise<void> | undefined;
+  const within = async <T>(pending: Promise<T>, milliseconds: number): Promise<T> => {
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    try {
+      return await Promise.race([
+        pending,
+        new Promise<T>((_, reject) => {
+          timer = setTimeout(() => reject(new Error('SCRATCH_TEST_SETUP_DEADLINE')), milliseconds);
+        }),
+      ]);
+    } finally {
+      clearTimeout(timer);
+    }
+  };
+
+  try {
+    const pending = closeOwnedResource(resource, {
+      deadlineMs: 250,
+      readStartIdentity: async () => identity,
+      stop: async () => true,
+      confirmStopped: async () => true,
+      remove: createScratchRemoval(scratchPath, identity, {
+        stat: async (path) => {
+          assert.equal(path, scratchPath);
+          markStatStarted();
+          await delayed;
+          return { dev: original.dev, ino: original.ino };
