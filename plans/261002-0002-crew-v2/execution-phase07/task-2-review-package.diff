+    () => broken.push(new Uint8Array([0x64, 0x61, 0x74, 0x61, 0x3a, 0xff, 0x0a, 0x0a])),
+    (error: unknown) => error instanceof SseProtocolError && error.code === 'UTF8_INVALID',
+  );
+});
