+function ticket(id: string, title: string, overrides: Partial<Ticket> = {}): Ticket {
+  return {
+    id,
+    projectId,
+    parentId: null,
+    rootId: id,
+    level: 'request',
+    kind: 'code',
+    title,
+    description: 'Mô tả',
