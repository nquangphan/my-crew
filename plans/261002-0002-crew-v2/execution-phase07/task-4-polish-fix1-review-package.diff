+    for (let k = 1; k < pts.length; k++)
+      assert.ok(pts[k]?.x === pts[k - 1]?.x || pts[k]?.y === pts[k - 1]?.y, `${edge.id} không có đoạn chéo`);
+    const trunk = pts[1] as { x: number; y: number };
+    const right = sameColumn ? Math.max(first.x, last.x) : left;
