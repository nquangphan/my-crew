+    `DEPENDENCY_CYCLE:${id(18)}`,
+    `DEPENDENCY_DANGLING:dependency:${id(777)}:${id(10)}`,
+    `REPAIR_DANGLING:repair:${cycle(1)}:${id(10)}:${id(888)}`,
