+test('I5: abandon gặp ATTACHMENT_SELECTION_STALE thì đọc lại revision rồi bỏ lượt gửi', async () => {
+  const env = await setup(commentSubmission(''));
+  await env.controller.addFiles([pngFile('a.png', 1)], 'input');
