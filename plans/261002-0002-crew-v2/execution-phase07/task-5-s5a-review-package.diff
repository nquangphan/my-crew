+
+export type ComposeControllerOptions = {
+  draftKey: string;
+  submission: ComposeSubmission;
+  client: OwnerClient;
+  pending: PendingStore;
+  storage: TabStorage | null;
+  hasher: FileHasher;
+  loadPolicy: (signal: AbortSignal) => Promise<AttachmentPolicy>;
