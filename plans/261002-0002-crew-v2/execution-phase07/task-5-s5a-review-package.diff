+  const id = 'aaaaaaaa-bbbb-4ccc-8ddd-000000000001';
+  const calls: RequestInit[] = [];
+  const serve =
+    (body: Uint8Array<ArrayBuffer>, status = 200) =>
+    async (_url: string, init?: RequestInit) => {
