+  }
+
+  // ---- form input -------------------------------------------------------------------------------------
+
+  /**
+   * Controlled submission update. Refused while a submit is frozen (sending/ambiguous/suspended/accepted),
+   * except re-entry of content for a tombstoned key. A changed target moves files to a new compose session.
