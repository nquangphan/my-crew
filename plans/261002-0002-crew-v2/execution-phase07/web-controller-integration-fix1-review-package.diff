+    const entry = await port.stat(path);
+    return { path, identity: String(entry.dev) + ':' + String(entry.ino) };
+  } catch (error) {
+    await port.rm(made, { recursive: true, force: true }).catch(() => undefined);
+    throw error;
+  }
+}
