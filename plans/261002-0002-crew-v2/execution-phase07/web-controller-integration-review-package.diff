+    'docs/hướng-dẫn/bắt-đầu.md',
+  );
+
+  await page.reload();
+  await expect(content.getByRole('heading', { name: 'Bắt đầu nhanh' }).first()).toBeVisible();
+  await expect(content.getByText('ước lượng, đường dẫn')).toBeVisible();
