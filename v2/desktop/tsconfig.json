{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "types": ["node", "electron"],
    "jsx": "react-jsx"
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
