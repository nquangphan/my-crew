# Database riêng cho Crew v2, tên bắt đầu bằng crew_v2_. Không dùng DSN v1.
CREW_V2_DATABASE_URL=postgres://crew_v2_user@db.internal:5432/crew_v2_prod
CREW_V2_PUBLIC_ORIGIN=https://crew-v2.example.com
CREW_V2_PORT=8788
# 32 byte ngẫu nhiên dưới dạng 64 ký tự hex; cấp qua secret manager, không commit giá trị thật.
CREW_V2_SESSION_ENCRYPTION_KEY=
